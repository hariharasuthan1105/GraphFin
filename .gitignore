# Python Bytecode and Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Model Artifacts (local runtime persistence)
data/models/*
!data/models/.gitkeep

# Processed Data (runtime output, intermediate datasets)
data/processed/*
!data/processed/.gitkeep

# Raw / downloaded datasets (large source files > 50MB)
data/raw/*
!data/raw/.gitkeep
!data/raw/sample_transactions.csv
data/raw/PS_*.csv
*.zip
*.gz

# Research dataset fixtures
# Exclude raw/large files over 50MB; whitelist small committable research artifacts (<50MB)
data/research/*.csv
!data/research/README.md
!data/research/ibm_aml_medium_5k.csv
!data/research/ibm_aml_medium_5k_labels.csv
!data/research/ibm_aml_large_50k.csv
!data/research/ibm_aml_large_50k_labels.csv
!data/research/paysim_labels.csv
!data/research/paysim_transactions.csv

# Exported Research Results (generated runs)
data/results/*
!data/results/.gitkeep
!data/results/final_e0_e4_comparison.json
!data/results/final_e0_e4_comparison.csv
!data/results/final_multiseed_robustness.json
!data/results/final_multiseed_robustness.csv
!data/results/cross_dataset/
!data/results/cross_dataset/**
data/results/cross_dataset/archive/
!data/results/permutation_and_casestudy/
!data/results/permutation_and_casestudy/**
!data/results/final_report/
!data/results/final_report/**

# Temporary / Log files
scratch/
*.tmp
*.log

# Local IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local model artifacts
*.joblib

# Frontend dependencies and build output
frontend/node_modules/
frontend/.next/
frontend/out/
dist/

# Antigravity / Gemini local files
.gemini/

# Test artifacts
test_*.pdf

